# Copy this file to ".env" (same folder as server.js) and fill in your details.
# Restart the server after changing it.

# ---- Admin panel ----
ADMIN_PASSWORD=change-this-password

# ---- Public address of your website (used inside emails & QR codes) ----
# Leave empty while testing on your own computer. When live, e.g. https://hitzone.lk
BASE_URL=

# ---- Where booking alerts are sent (comma separate for several people) ----
ADMIN_EMAIL=owner@example.com

# ---- Email sending (SMTP). Example below is for Gmail ----
# Gmail: turn on 2-Step Verification, then create an "App password"
# (Google Account > Security > App passwords) and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-16-letter-app-password
MAIL_FROM="HITZONE Indoor Cricket Arena <yourname@gmail.com>"

# ---- Optional ----
# PORT=3000
# TRUST_PROXY=true     # set when running behind nginx / a hosting proxy
